# Copy this file to ".env" and fill in real values. Never commit ".env".
#
# Mapbox public access token (starts with "pk.").
# Restrict it by URL/domain in your Mapbox account so it can't be abused.
# Once set, read it in code via import.meta.env.VITE_MAPBOX_TOKEN
# (see src/utils/constants.js — pending migration, audit item A3).
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
